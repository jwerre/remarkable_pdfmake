{
	"name": "remarkable_pdfmake",
	"version": "0.0.1",
	"description": "Convert markdown text to [PDFMake](https://github.com/bpampuch/pdfmake) arguments.",
	"type": "module",
	"main": "./index.js",
	"exports": {
		".": "./index.js"
	},
	"files": [
		"index.js",
		"lib",
		"README.md"
	],
	"engines": {
		"node": ">= 20"
	},
	"repository": {
		"type": "git",
		"url": "git@github.com:jwerre/remarkable_pdfmake.git"
	},
	"bugs": {
		"url": "https://github.com/jwerre/remarkable_pdfmake/issues"
	},
	"homepage": "https://github.com/jwerre/remarkable_pdfmake",
	"author": "Jonah Werre <jonahwerre@gmail.com>",
	"license": "MIT",
	"scripts": {
		"check": "npm audit --audit-level=moderate --omit=dev && npm run spell && npm run format && npm run lint && npm run test:ci && npm run release:dry",
		"format": "prettier \"**/*.js\" --check",
		"format:fix": "prettier \"**/*.js\" --write",
		"lint": "eslint",
		"release": "semantic-release",
		"release:dry": "semantic-release --dry-run",
		"spell": "cspell lint .",
		"test": "vitest",
		"test:ci": "npm test -- --run"
	},
	"keywords": [
		"document",
		"glossary",
		"link",
		"datauri",
		"bold",
		"strong",
		"italic",
		"italicized",
		"image",
		"markdown",
		"md",
		"plugin",
		"remarkable",
		"remarkableplugin",
		"parcer",
		"render"
	],
	"peerDependencies": {
		"remarkable": "^2.0.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/github": "^12.0.6",
		"@semantic-release/npm": "^13.1.5",
		"cspell": "^9.7.0",
		"eslint": "^10.0.3",
		"globals": "^17.4.0",
		"mocha": "^11.7.5",
		"pdfmake": "^0.3.6",
		"prettier": "^3.8.1",
		"remarkable": "^2.0.1",
		"semantic-release": "^25.0.3",
		"vitest": "^4.0.18"
	}
}
